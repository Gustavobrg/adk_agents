# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env

# --- OpenRouter (travel_agent) ---------------------------------------------
# Chave criada em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slug do modelo no OpenRouter (o prefixo "openrouter/" e adicionado
# automaticamente pelo codigo). Exemplos:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
#   google/gemini-2.5-flash
MODEL=anthropic/claude-sonnet-4.5

# Endpoint do OpenRouter. So mude se usar um proxy/gateway proprio.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Google Cloud Logging ---------------------------------------------------
# Os agentes chamam google.cloud.logging.Client() no import, o que exige
# credenciais validas mesmo usando OpenRouter como LLM.
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# --- Google Search (brainstorm_agent, research scouts) ----------------------
# google_search e um built-in tool do Gemini -- so funciona com um model
# Gemini de verdade (nao atras do LiteLlm/OpenRouter). Autentique via
# GOOGLE_API_KEY OU via Vertex AI (GOOGLE_GENAI_USE_VERTEXAI=TRUE +
# GOOGLE_CLOUD_PROJECT/GOOGLE_CLOUD_LOCATION acima).
GOOGLE_API_KEY=
GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# --- Google Geocoding API (research_tools.validate_poi) ---------------------
# Chave criada em https://console.cloud.google.com/google/maps-apis --
# precisa da Geocoding API habilitada e billing ativo no projeto.
GOOGLE_MAPS_API_KEY=
