# Copie este arquivo para .env e preencha os valores.
# cp client/.env.example client/.env

# --- Vertex AI Agent Engine (agente ja implantado) --------------------------
# Projeto e regiao usados no deploy (adk deploy agent_engine).
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# Nome completo do recurso, impresso ao final do "adk deploy agent_engine"
# (formato projects/{project}/locations/{location}/reasoningEngines/{id}).
# Exemplo real do ultimo deploy deste repo:
#   projects/397175358678/locations/us-central1/reasoningEngines/6319932913072734208
AGENT_ENGINE_RESOURCE_NAME=projects/seu-projeto-gcp/locations/us-central1/reasoningEngines/SEU_ID

# Autenticacao: use as mesmas Application Default Credentials do deploy
#   gcloud auth application-default login
