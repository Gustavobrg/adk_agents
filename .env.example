# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- OpenRouter (travel_agent) ---------------------------------------------
# Key created at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model slug on OpenRouter (the "openrouter/" prefix is added
# automatically by the code). Examples:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
#   google/gemini-2.5-flash
MODEL=anthropic/claude-sonnet-4.5

# OpenRouter endpoint. Only change if using your own proxy/gateway.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Google Cloud Logging ---------------------------------------------------
# The agents call google.cloud.logging.Client() on import, which requires
# valid credentials even when using OpenRouter as the LLM.
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
